# API-Football (RapidAPI or direct api-football.com key)
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_channel_or_chat_id_here

# Database
# For SQLite (default, zero-setup): sqlite+aiosqlite:///./no3bot.db
# For Postgres: postgresql+asyncpg://no3:change_me@localhost:5432/no3bot
DATABASE_URL=sqlite+aiosqlite:///./no3bot.db

# Redis
REDIS_URL=redis://redis:6379/0

# App
TIMEZONE=Africa/Lagos
LOG_LEVEL=INFO
